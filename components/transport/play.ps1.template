function Test-CommandExists
{
  param ($command)
  $oldPreference = $ErrorActionPreference
  $ErrorActionPreference = 'stop'
  try {if(Get-Command $command){return $true}}
  catch {return $false}
  finally {$ErrorActionPreference=$oldPreference}
}

if (!(Test-CommandExists docker)) {
  Write-Host "Command 'docker' was not found."
  Exit
}

if (docker ps -q -f name=rrp-player) {
  Write-Host "Player already running"
} else {
  Write-Host "Loading RRP player image"
  Start-Process docker load -RedirectStandardInput "$PSScriptRoot\image.tar" -NoNewWindow -Wait
  docker tag ${FULL_IMAGE} ${IMAGE}:${TAG}
  docker rmi ${FULL_IMAGE}

  docker run `
  -d `
  --rm `
  --publish 8888:8888 `
  --mount "type=bind,source=$PSScriptRoot\repo,target=/home/jovyan/project" `
  --mount "type=bind,source=$PSScriptRoot\openbis,target=/home/jovyan/openbis" `
  --mount "type=bind,source=$PSScriptRoot\results,target=/home/jovyan/results" `
  --workdir /home/jovyan `
  --entrypoint /bin/bash `
  -e RRP_ORIG_CMD='${COMMAND}' `
  --name rrp-player `
  ${IMAGE}:${TAG} `
  -c 'if [ -f /home/jovyan/.binder/start ]; then /bin/bash /home/jovyan/.binder/start /bin/bash -c "$RRP_ORIG_CMD"; else /bin/bash -c "$RRP_ORIG_CMD"; fi'

  Write-Host -NoNewline "Waiting for the container to start"
  while(-Not (docker exec -it rrp-player bash -c 'cat /proc/net/tcp 2>/dev/null|grep 22B8')) {
    Write-Host -NoNewline "."
    Start-Sleep -Seconds 2
  }
  Write-Host ""
  docker exec -u root rrp-player bash -c 'chown -R jovyan:jovyan /home/jovyan/*'
}

Start-Process http://localhost:8888/lab
